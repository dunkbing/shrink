        "Utility"
      ],
      "keywords": [
        "compress",
        "optimize",
        "image",
        "video"
      ],
      "maintainer": "dunkbing <dunkbing@users.noreply.github.com>"
    },
    "windows": {
      "publisher": "dunkbing",
      "scope": "user"
