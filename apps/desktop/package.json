{
  "name": "shrink-desktop",
  "license": "MIT",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mantou dev src/main.tsx",
    "start": "mantou run src/main.tsx",
    "package": "mantou package src/main.tsx --name Shrink --id dev.dunkbing.shrink --version 0.1.1"
  },
  "dependencies": {
    "@shrink/engine": "workspace:*",
    "mantou-ui": "^0.5.2"
